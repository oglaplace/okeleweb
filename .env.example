# Copy to `.env`. Almost everything here is DEV-ONLY.
#
# In production the API base and deployment label come from /config.json, which
# is written by whoever deploys the bundle (cloud or edge box) — NOT from these
# variables. See src/lib/runtime.ts. That is deliberate: one build must be
# deployable to both, or a tier migration would need a rebuild.

# Dev-only override of the API base. Leave blank to use /api (Vite proxies it).
VITE_API_URL=

# Where the Vite dev proxy forwards /api. Must match ecole-api's PORT.
VITE_API_ORIGIN=http://localhost:3000

# Standalone UI dev with no backend: demo OTP code 123456.
VITE_USE_MOCK=false

# ── Firebase phone auth ──────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
